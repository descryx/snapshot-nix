// Animation settings.
// The wiki explains how to configure individual animations:
// https://niri-wm.github.io/niri/Configuration:-Animations

// NOTE: custom animations
// 2nd one overrides the first one. but only the animations that it has.
include "./niri-animation-collection/animations/prism_fold.kdl"
include "./niri-animation-collection/animations/dither-glitch.kdl"
// include "./niri-animation-collection/animations/pixel-sort.kdl"


animations {
    slowdown 0.7

    // NOTE:
    // commented out = replaced with custom animation.

    // window-open { duration-ms 220; curve "cubic-bezier" 0.05 0.7 0.1 1.0; }
    // window-close { duration-ms 150; curve "cubic-bezier" 0.3 0 0.8 0.15; }
    // window-resize { spring damping-ratio=1.0 stiffness=1800 epsilon=0.0001; }
    window-movement { duration-ms 120; curve "cubic-bezier" 0.16 1.0 0.3 1.0; }

    horizontal-view-movement { spring damping-ratio=1.0 stiffness=2200 epsilon=0.0001; }
    workspace-switch { spring damping-ratio=1.0 stiffness=2200 epsilon=0.0001; }

    config-notification-open-close { duration-ms 150; curve "ease-out-cubic"; }
    screenshot-ui-open { duration-ms 150; curve "ease-out-quad"; }
    overview-open-close { spring damping-ratio=1.0 stiffness=1500 epsilon=0.0001; }
}
